<Project Sdk="Microsoft.NET.Sdk">

  <!-- The host. References every use case it can run plus the configuration binder.
       Aggregating drivers here is fine — the dependency-free rule applies to Core, not the host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Benchmark.Cli</RootNamespace>
    <AssemblyName>benchmark</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Benchmark.Core\Benchmark.Core.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.Abstractions\Benchmark.UseCases.Database.Abstractions.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.Postgres\Benchmark.UseCases.Database.Postgres.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.Mssql\Benchmark.UseCases.Database.Mssql.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.DeviceViews.Abstractions\Benchmark.UseCases.Database.DeviceViews.Abstractions.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.DeviceViews.Postgres\Benchmark.UseCases.Database.DeviceViews.Postgres.csproj" />
    <ProjectReference Include="..\UseCases\Benchmark.UseCases.Database.DeviceViews.Mongo\Benchmark.UseCases.Database.DeviceViews.Mongo.csproj" />
  </ItemGroup>

</Project>
